# Local Docker Postgres. For Neon, paste its postgresql://...?sslmode=require URL instead.
DATABASE_URL=postgresql+psycopg://architect:architect@localhost:5432/architect
JWT_SECRET=change-me
OPENAI_API_KEY=
OPENAI_MODEL=
# Comma-separated if there are several, e.g. https://architect.vercel.app,http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GITHUB_TOKEN=
